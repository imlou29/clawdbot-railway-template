{
  "id": "tegridy-reply-references",
  "name": "Tegridy Reply References",
  "description": "Links to confirmed, recent Telegram answers in a configured forum topic.",
  "activation": {
    "onCapabilities": [
      "hook"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "sessionKey",
      "directory",
      "revisionFiles"
    ],
    "properties": {
      "sessionKey": {
        "type": "string",
        "pattern": "^agent:[^:]+:telegram:group:-100[0-9]+:topic:[0-9]+$"
      },
      "directory": {
        "type": "string",
        "minLength": 1
      },
      "revisionFiles": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "accountId": {
        "type": "string",
        "default": "default"
      }
    }
  }
}
